# ===== 後端（Render 服務的環境變數，或本機 .env 以 `node --env-file=.env server.js` 載入）=====
PORT=3090
# 允許連線的前端來源（逗號分隔）。production 務必設定；本機開發留空即可（同源與任何來源皆允許）。
GAME_ALLOWED_ORIGIN=http://localhost:3090
NODE_ENV=development

# ===== 前端（GitHub Pages）=====
# 不寫進程式碼，由 GitHub Actions repository variable `GAME_SERVER_URL` 在建置時注入（scripts/build-pages.js）。
# 值為 Render 後端的公開 HTTPS 網址，例如 https://house-stack-server.onrender.com
# 本機測試 Pages 建置：GAME_SERVER_URL=http://localhost:3090 npm run build:pages
GAME_SERVER_URL=
